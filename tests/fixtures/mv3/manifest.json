{
  "manifest_version": 3,
  "name": "Always Active MV3 compatibility fixture",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "worker.js"},
  "content_scripts": [{"matches":["http://127.0.0.1/*", "http://localhost/*"],"js":["content.js"],"run_at":"document_start","all_frames":true}]
}
