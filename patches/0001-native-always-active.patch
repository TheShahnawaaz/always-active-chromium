+bool Document::AlwaysActiveEnabled() const {
+  if (!base::FeatureList::IsEnabled(features::kAlwaysActive) || !dom_window_ ||
+      !GetFrame() || !GetPage() || !IsActive() || IsPrerendering()) {
+    return false;
+  }
+  if (Url().ProtocolIsInHTTPFamily()) {
+    return true;
+  }
+  // Include web-origin inherited/opaque frames, but never browser UI or
+  // extension documents. This origin check only selects behavior; it grants
+  // no origin access, permissions, or user activation.
+  if (!Url().ProtocolIs("about") && !Url().ProtocolIs("blob") &&
+      !Url().ProtocolIsData() && !Url().ProtocolIs("filesystem")) {
+    return false;
+  }
+  const SecurityOrigin* origin = dom_window_->GetSecurityOrigin()
+                                     ->GetOriginOrPrecursorOriginIfOpaque();
+  return origin &&
+         (origin->Protocol() == "http" || origin->Protocol() == "https");
+}
+
+bool Document::hiddenForBindings() const {
+  return !AlwaysActiveEnabled() && hidden();
+}
+
+V8VisibilityState Document::visibilityStateForBindings() const {
+  return V8VisibilityState(hiddenForBindings()
+                               ? V8VisibilityState::Enum::kHidden
+                               : V8VisibilityState::Enum::kVisible);
+}
+
+String Document::visibilityStateAsStringForBindings() const {
+  return visibilityStateForBindings().AsString();
+}
+
+bool Document::ShouldSuppressAlwaysActiveEvent(const Event& event) {
+  if (!AlwaysActiveEnabled()) {
+    return false;
+  }
+  const AtomicString& type = event.type();
+  if (base::FeatureList::IsEnabled(features::kAlwaysActiveFullscreen) &&
+      !IsPageVisible() &&
+      (type == event_type_names::kFullscreenchange ||
+       type == event_type_names::kWebkitfullscreenchange ||
+       type == event_type_names::kFullscreenerror ||
+       type == event_type_names::kWebkitfullscreenerror)) {
+    return true;
+  }
+  if (!base::FeatureList::IsEnabled(features::kAlwaysActiveEvents)) {
+    return false;
+  }
+  if (type == event_type_names::kVisibilitychange ||
+      type == event_type_names::kWebkitvisibilitychange ||
+      type == event_type_names::kPagehide ||
+      type == event_type_names::kLostpointercapture) {
+    return true;
+  }
+  EventTarget* target = event.RawTarget();
+  if (!target) {
+    return false;
+  }
+  const bool document_or_window =
+      target->ToNode() == this || target->ToLocalDOMWindow() == dom_window_.Get();
+  if (document_or_window && type == event_type_names::kFocus) {
+    // The shipped extension permits its first document/window focus event.
+    // Retain that event so capture and target phases make the same decision.
+    if (!always_active_initial_focus_event_) {
+      always_active_initial_focus_event_ = &event;
+    }
+    return always_active_initial_focus_event_ != &event;
+  }
+  if (document_or_window &&
+      (type == event_type_names::kBlur ||
+       type == event_type_names::kMouseleave)) {
+    return true;
+  }
+  return type == event_type_names::kMouseout &&
+         (target->ToNode() == documentElement() || target->ToNode() == body());
+}
+
+void Document::UpdateAlwaysActiveFullscreenElement(Element* element) {
+  if (AlwaysActiveEnabled() &&
+      base::FeatureList::IsEnabled(features::kAlwaysActiveFullscreen) &&
+      (IsPageVisible() || element)) {
+    always_active_fullscreen_element_ = element;
+  }
+}
+
+Element* Document::AlwaysActiveFullscreenElementForBindings() const {
+  if (AlwaysActiveEnabled() &&
+      base::FeatureList::IsEnabled(features::kAlwaysActiveFullscreen) &&
+      !IsPageVisible() && always_active_fullscreen_element_ &&
+      always_active_fullscreen_element_->isConnected()) {
+    return always_active_fullscreen_element_.Get();
+  }
+  return nullptr;
+}
