+void ScriptedAnimationController::UpdateAlwaysActiveTimer() {
+  auto* window = GetExecutionContext() ? GetWindow() : nullptr;
+  Document* document = window ? window->document() : nullptr;
+  if (!document || GetExecutionContext()->IsContextDestroyed() ||
+      GetExecutionContext()->IsContextPaused() ||
+      !document->AlwaysActiveEnabled() || document->IsPageVisible() ||
+      !base::FeatureList::IsEnabled(features::kAlwaysActiveAnimationFrames) ||
+      !callback_collection_.HasWebFrameCallback()) {
+    always_active_timer_.Stop();
+    return;
+  }
+  if (!always_active_timer_.IsActive()) {
+    // Like the extension's setTimeout fallback, this remains subject to
+    // background timer throttling and lifecycle freezing; it is not a display
+    // refresh or a guarantee of 60fps. Internal animation work is unaffected.
+    always_active_timer_.StartOneShot(base::Milliseconds(16), FROM_HERE);
+  }
+}
+
+void ScriptedAnimationController::AlwaysActiveTimerFired(TimerBase*) {
+  auto* window = GetExecutionContext() ? GetWindow() : nullptr;
+  if (!window || GetExecutionContext()->IsContextDestroyed() ||
+      GetExecutionContext()->IsContextPaused() || !window->document() ||
+      !window->document()->AlwaysActiveEnabled() ||
+      window->document()->IsPageVisible() ||
+      !base::FeatureList::IsEnabled(features::kAlwaysActiveAnimationFrames)) {
+    return;
+  }
+  const double now = DOMWindowPerformance::performance(*window)->now();
+  callback_collection_.ExecuteWebFrameCallbacks(now, now);
+  UpdateAlwaysActiveTimer();
+}
